# Gridscore environment (names only — no values committed)

# Payment rails (GOAT Network, USDC)
GRIDSCORE_PAY_TO=
GRIDSCORE_USDC_ADDRESS=
GRIDSCORE_USDC_DECIMALS=6
GRIDSCORE_PRICE_USD=0.75

# Chain RPC overrides (defaults are public endpoints)
GRIDSCORE_RPC_GOAT=
GRIDSCORE_RPC_ETHEREUM=
GRIDSCORE_RPC_BASE=
GRIDSCORE_RPC_ARBITRUM=
GRIDSCORE_RPC_OPTIMISM=
GRIDSCORE_RPC_POLYGON=
GRIDSCORE_RPC_BNB=
GRIDSCORE_RPC_AVALANCHE=

# Limits
GRIDSCORE_CHAIN_TIMEOUT_MS=8000
GRIDSCORE_JOB_HARD_CAP_MS=50000
GRIDSCORE_MAX_TXS_PER_CHAIN=200
GRIDSCORE_PORT=8787
GRIDSCORE_STATE_FILE=

# Where the web app finds the worker
WORKER_URL=http://127.0.0.1:8787

# Optional verdict text provider (OpenAI-compatible endpoint).
# Unset -> the template verdict is used.
VERDICT_API_KEY=
VERDICT_MODEL=
VERDICT_BASE_URL=

# Agent identity shown on reports
GRIDSCORE_ERC8004_REGISTRY=
GRIDSCORE_ERC8004_AGENT_ID=
